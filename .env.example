# Portfolio AI Chatbot - Environment Variables

NEXT_PUBLIC_TO_EMAIL=syedasimshahh@gmail.com

# OpenAI API Configuration
OPENAI_API_KEY=sk-...

# MongoDB Atlas Connection String
# Get this from: https://cloud.mongodb.com/
# MONGODB_URI=mongodb+://username:password@cluster.mongodb.net/portfolio_chatbot

# Google Gemini API Key
# Get this from: https://ai.google.dev/

# Optional: Logging Level
LOG_LEVEL=info

# Optional: Vector Search Configuration
MIN_SIMILARITY_SCORE=0.70
MAX_RESULTS=5

# Next.js Configuration
NEXT_PUBLIC_SITE_URL=https://aasimshah.com

# Paddle.js configuration for the staged live build.
# Do not deploy until the live domain is approved and verification is complete.
NEXT_PUBLIC_PADDLE_ENV=production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_replace_me

# Paddle server-side fulfillment (never expose these as NEXT_PUBLIC_*)
PADDLE_ENV=production
PADDLE_API_KEY=pdl_live_apikey_replace_me
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_replace_me
PADDLE_NOTIFICATION_SETTING_ID=ntfset_replace_me

# Vercel supplies a trusted x-vercel-forwarded-for automatically. Set this
# only when self-hosting behind a proxy that overwrites the named header.
# PADDLE_WEBHOOK_CLIENT_IP_HEADER=x-forwarded-for

# Explicit MongoDB database used by the Paddle state mirror
MONGODB_DB_NAME=aasimshah-portfolio
